<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact SignPath (projet MondoWrite, à recopier dans SignPath : Projects › MondoWrite ›
  Artifact configurations). L'artefact envoyé par release.yml est un .zip qui contient l'installeur MSI
  et l'installeur NSIS (-setup.exe) de Windows, à sa racine. Les deux sont signés (Authenticode) et doivent
  porter le nom de produit MondoWrite.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <msi-file path="MondoWrite_*_x64_*.msi">
      <authenticode-sign description="MondoWrite" description-url="https://github.com/sebastienpiconnier/MondoWrite" />
    </msi-file>
    <pe-file path="MondoWrite_*_x64-setup.exe" product-name="MondoWrite">
      <authenticode-sign description="MondoWrite" description-url="https://github.com/sebastienpiconnier/MondoWrite" />
    </pe-file>
  </zip-file>
</artifact-configuration>
