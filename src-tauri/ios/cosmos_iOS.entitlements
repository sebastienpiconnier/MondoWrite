<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Droits de l'app iPhone/iPad : iCloud Drive (documents). Copié dans src-tauri/gen/apple par `npm run ios:prepare`.
     Le conteneur iCloud.app.cosmos.ecriture doit exister sur developer.apple.com (Identifiers > iCloud Containers). -->
<plist version="1.0">
<dict>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.app.cosmos.ecriture</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudDocuments</string>
  </array>
  <key>com.apple.developer.ubiquity-container-identifiers</key>
  <array>
    <string>iCloud.app.cosmos.ecriture</string>
  </array>
</dict>
</plist>
