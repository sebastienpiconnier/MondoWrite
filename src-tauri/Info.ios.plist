<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fusionné par Tauri dans l'Info.plist de l'app iOS (à chaque `tauri ios build` ou `dev`, src-tauri/gen/ n'est
     pas versionné). Sur iPhone, l'app reste en portrait : la clé « ~iphone » l'emporte sur la liste générale, et
     l'iPad garde toutes les orientations. L'écran intérieur de l'iPhone Duo (déplié) ignore cette liste : l'app
     y tourne librement, comme sur un iPad. L'écran extérieur du Duo reste un iPhone, donc en portrait. -->
<plist version="1.0">
<dict>
  <key>UISupportedInterfaceOrientations~iphone</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
</dict>
</plist>
